# ============================================================================
# Runtime configuration contract. Copy to `.env` for a real deployment.
# VITE_ values are INLINED INTO THE BUILT CLIENT BUNDLE — never put a secret
# here. The Supabase service_role key and every encryption key live server-side.
# ============================================================================

# demo       = fake data, browser-local storage, demo banner. Never for real records.
# production = real records. Requires a configured backend; the app REFUSES TO
#              START (fail closed) rather than serving mock patients.
# Unset: `vite dev` resolves to demo, `vite build` resolves to production.
VITE_APP_MODE=production

# Backend (Supabase project) — anon key only.
VITE_SUPABASE_URL=https://REPLACE-WITH-YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=REPLACE-WITH-PUBLIC-ANON-KEY

# Support contact rendered in every section footer.
VITE_SUPPORT_EMAIL=REPLACE-WITH-FOUNDATION-EMAIL
VITE_SUPPORT_PHONE=REPLACE-WITH-FOUNDATION-PHONE
