# Dependencies
node_modules/

# Build output
dist/
dist-ssr/

# Logs
logs/
*.log
npm-debug.log*

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store

# Env files
.env
.env.*
!.env.example
# The demo-mode file carries no secrets, only VITE_APP_MODE=demo; it must be
# committed or `npm run build:demo` silently produces a production-mode bundle.
!.env.demo

# Supabase local CLI artifacts, and the scratch dumps/probe scripts that
# `supabase db query -f` and the go-live runbook write here.
supabase/.temp/
# Scratch stays out (generated harness SQL, the hosted schema snapshot, the 0011
# draft splits); the scripts Documentation.md and the runbook *cite by path* are
# tracked — a fresh clone has to be able to re-run the gate checks and the seeded
# credential closure, not take them on faith. Note `supabase/db/*`, not
# `supabase/db/`: git never descends into an ignored directory, so a directory
# rule would make every negation below silently inert.
supabase/db/*
!supabase/db/check-*.sql
!supabase/db/post-apply-verify.sql
!supabase/db/revoke-seeded-accounts.sql
!supabase/db/probe-revoked.sql
!supabase/db/approve-live.sql
!supabase/db/dryrun-approve.sql
!supabase/db/snapshot-manifest.sql

# Agent-local state (memory, sessions) — never committed
.workbuddy-ai/

# Vercel CLI project link + pulled env.
# `.env.local` is already covered by `.env.*` above; do NOT add a blanket
# `.env*` here — `.env.example` and `.env.demo` are committed on purpose.
.vercel
